{% if section.settings.hero_image != blank %}
  <section class="section hero">
    <img
      class="hero-image"
      src="{{ section.settings.hero_image | image_url: width: 1800 }}"
      alt="{{ section.settings.hero_alt | escape }}"
      loading="eager"
      fetchpriority="high"
    >
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero-actions">
        <a href="{{ section.settings.primary_link }}" class="btn btn-default btn-lg">{{ section.settings.primary_label }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="{{ section.settings.secondary_link }}" class="text-link hero-secondary">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
    <div class="hero-caption">{{ section.settings.caption }}</div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A Gabrielle · A little luxury for your skin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet your new daily ritual." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Handcrafted body butters and body oils made to bring a little more care, comfort, and glow to your everyday routine." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Discover Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Made with care. Made for you." },
    { "type": "text", "id": "hero_alt", "label": "Image alt text", "default": "Luxury skincare collection arranged in light" }
  ]
}
{% endschema %}
